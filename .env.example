POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint
POSTGRES_DB=waypoint

# Modelos. Haiku arma itinerarios, Sonnet conversa.
ANTHROPIC_API_KEY=
PLANNER_MODEL=claude-haiku-4-5-20251001
CHAT_MODEL=claude-sonnet-5

# OpenRouteService: cuenta gratis en account.heigit.org, sin tarjeta.
ORS_API_KEY=
# Segundos minimos entre llamadas a ORS. La leccion de Voyage: ante un limite
# conocido se controla el ritmo en origen, no se reintenta a ciegas.
ORS_MIN_INTERVAL_SECONDS=1.5

# Origenes permitidos para CORS, separados por coma.
CORS_ORIGINS=http://localhost:3000
